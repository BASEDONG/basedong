{
  "name": "@basedong/web",
  "version": "0.1.0",
  "private": true,
  "description": "Basedong SaaS console UI (SiliconFlow clone output)",
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --import ./scripts/register-ts-paths.mjs --experimental-strip-types scripts/expand-locale-static-export.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locale-catalogs.mjs && node --import ./scripts/register-ts-paths.mjs --experimental-strip-types scripts/check-locale-helpers.mjs",
    "check:docs-locales": "node scripts/check-docs-locales.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:locales && npm run check:docs-locales && npm run build",
    "sync:docs": "node scripts/sync-newapi-docs.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.2.0",
    "fumadocs-openapi": "10.1.0",
    "fumadocs-ui": "16.2.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "next-mdx-remote": "^6.0.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "shiki": "3.15.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "msw@2.12.14": true,
    "unrs-resolver@1.11.1": true
  }
}
