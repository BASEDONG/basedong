{
  "name": "basedong",
  "version": "0.1.0",
  "private": true,
  "description": "Basedong monorepo — SaaS console evolved from website clone output",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "build:cf": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "check": "npm run check --workspace=apps/web"
  }
}
