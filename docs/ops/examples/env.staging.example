# Staging secrets / config for Topology B.
# Copy to repo-root `.env.staging` (gitignored) or a host secret store. Never commit real values.
#
# Usage:
#   docker compose --env-file .env.staging \
#     -f docker-compose.yml \
#     -f docs/ops/examples/docker-compose.staging.yml \
#     up -d --build api redis postgres

# --- Domains (documentation; wire DNS yourself) ---
# APP_ORIGIN=https://app.example.com
# API_ORIGIN=https://api.example.com

# --- Postgres (compose postgres service + API SQL_DSN) ---
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=new-api
SQL_DSN=postgresql://root:change-me-strong-db-password@postgres:5432/new-api

# --- Redis ---
REDIS_CONN_STRING=redis://redis:6379

# --- Session / crypto (required for public HTTPS staging) ---
# Generate high-entropy values, e.g. openssl rand -hex 32
SESSION_SECRET=
CRYPTO_SECRET=
SESSION_COOKIE_TRUSTED_URL=https://app.example.com
TRUSTED_PROXIES=127.0.0.1/32

# --- Host bind (Caddy on same machine proxies to this) ---
API_PORT=3000
TZ=Asia/Shanghai

# --- Optional Zen Sidecar ---
# docker-compose.zen-sidecar.yml hardcodes SIDECAR_KEY / UPSTREAM / ALLOWLIST.
# Edit that overlay (or a private overlay) for staging secrets; Channel.Key must match.
# Never keep basedong-sidecar-dev-credential on a shared host.

# --- Cloudflare Pages build env (set in Pages dashboard, not compose) ---
# NEXT_PUBLIC_API_BASE=https://api.example.com
