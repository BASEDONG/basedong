# Copy to docs/qa/.env.qa.local (gitignored) and fill in. Never commit secrets.

# Customer Web origin (no trailing slash)
BASE_WEB=http://localhost:3001

# Backend API + stock Admin UI origin (no trailing slash)
# Local compose default: http://localhost:3000
BASE_API=http://localhost:3000

# Pre-provisioned 用户 — Web login field accepts username or email.
# Example local account: username `qaui`, email `qa.ui@example.com` (use either in the field).
QA_USER_EMAIL=
QA_USER_PASSWORD=

# 管理员 for Admin UI /admin-api-ok steps
QA_ADMIN_USER=
QA_ADMIN_PASSWORD=

# Optional: unused 兑换码 for customer redeem success path
# (or produce one via admin/journey-admin-redemption-issue.md first)
QA_REDEEM_CODE=
